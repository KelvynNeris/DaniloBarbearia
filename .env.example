# Configuração do Banco de Dados MySQL
# IMPORTANTE: Renomeie este arquivo para .env e preencha com suas credenciais reais

# Para uso LOCAL (não Railway):
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=sua_senha_aqui
DB_NAME=barbearia_db
DB_PORT=3306

# Chave secreta do Flask (gere uma aleatória para produção)
SECRET_KEY=sua_chave_secreta_super_segura_aqui

# Modo de debug (use 'false' em produção)
FLASK_DEBUG=true

# Porta do servidor (padrão 8080)
PORT=8080

# --- Notificação por e-mail de novos agendamentos (opcional) ---
# Se deixar tudo em branco, o site funciona normalmente, só não manda o e-mail.
# Para onde manda o aviso de novo agendamento:
ADMIN_NOTIFY_EMAIL=seu_email@gmail.com

# Opção 1 (recomendada em hospedagens como Railway): Resend, via API HTTP.
# Não depende de porta SMTP liberada. Crie uma conta grátis em resend.com,
# gere uma API key em resend.com/api-keys e cole abaixo.
RESEND_API_KEY=
# RESEND_FROM=onboarding@resend.dev   # padrão do Resend sem domínio verificado

# Opção 2 (alternativa/fallback): SMTP direto — funciona bem local, mas
# alguns provedores de nuvem bloqueiam a porta de saída.
# Exemplo usando Gmail: crie uma "senha de app" em myaccount.google.com/apppasswords
# (não dá pra usar a senha normal da conta Google).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu_email@gmail.com
SMTP_PASSWORD=sua_senha_de_app_aqui
